{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitra",
  "version": "0.1.0",
  "identifier": "com.mitra.app",
  "build": {
    "devUrl": "http://127.0.0.1:8931",
    "frontendDist": "../src/mitra/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mitra",
        "url": "http://127.0.0.1:8931",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:8931; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icon.png"]
  }
}
