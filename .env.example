# Copy to .env and fill in. Never commit the real file.
# Key for OpenAI compatible providers (also used for Meta style endpoints).
MITRA_MODEL_KEY=
# GitHub personal access token. Needed for private repos and opening PRs.
# Public repo reads work without it. Never commit the real file.
MITRA_GITHUB_TOKEN=
# Optional overrides. Config file values apply when these are unset.
MITRA_PROVIDER=
MITRA_MODEL=
